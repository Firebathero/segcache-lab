+    /// One relaxed pass over a bucket for the fresh-insert decision: whether
+    /// a ghost with this tag is present, and the number of live entries.
+    /// Both are hints; the claim itself re-reads each slot and CASes.
+    #[inline]
+    fn scan_for_claim(&self, bucket_index: usize, tag: u16) -> (bool, usize) {
+        let bucket = self.bucket(bucket_index);
+        let mut has_ghost = false;
+        let mut occupied = 0;
+        for slot in &bucket.items {
+            let packed = slot.load(Ordering::Relaxed);
+            if packed == 0 {
+                continue;
+            }
+            if Hashbucket::is_ghost(packed) {
+                has_ghost |= Hashbucket::tag(packed) == tag;
+            } else {
+                occupied += 1;
+            }
+        }
+        (has_ghost, occupied)
+    }
